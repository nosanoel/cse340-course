<%- include('partials/header') %>

<main class="categories-page">
    <h1><%= title %></h1>
    <p>Explore the different categories of volunteer opportunities.</p>

    <section class="categories">
        <% categories.forEach(category => { %>
            <div class="category">
                <h2><%= category.name %></h2>
            </div>
        <% }); %>
    </section>
</main>

<%- include('partials/footer') %>
