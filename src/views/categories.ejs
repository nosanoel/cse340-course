<%- include('partials/header') %>

<!-- Main content for the categories page. -->
<main class="categories-page">
    <h1><%= title %></h1>
    <p>Explore the different categories of volunteer opportunities.</p>

    <!-- Loop through each category and link it to its detail page. -->
    <section class="categories">
        <% categories.forEach(category => { %>
            <div class="category">
                <h2><a href="/category/<%= category.category_id %>"><%= category.name %></a></h2>
            </div>
        <% }); %>
    </section>

    <p><a href="/new-category">Add a New Category</a></p>
</main>

<%- include('partials/footer') %>
