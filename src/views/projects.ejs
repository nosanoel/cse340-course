<%- include('partials/header') %>

<main class="projects-page">
    <h1><%= title %></h1>

    <h2>Upcoming Service Projects</h2>
    <ul>
        <% projects.forEach(project => { %>
            <li>
                <strong><%= new Date(project.project_date).toLocaleDateString(undefined, { year: 'numeric', month: 'long', day: 'numeric' }) %>: <%= project.title %> (<%= project.organization_name %>)</strong><br>
                <%= project.description %><br>
                Location: <%= project.location %><br>
                Categories: <%= project.category_names || 'None' %>
            </li>
        <% }); %>
    </ul>
</main>

<%- include('partials/footer') %>
