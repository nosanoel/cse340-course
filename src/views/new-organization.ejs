<%- include('partials/header') %>
<main class="form-page new-organization-page">
    <div class="form-page-heading">
        <p class="eyebrow">Organization Directory</p>
        <h1><%= title %></h1>
        <p>Add an organization to the service network.</p>
    </div>

    <form class="styled-form" action="/new-organization" method="POST">
        <div class="form-group">
            <label for="name">Organization Name</label>
            <input
                type="text"
                id="name"
                name="name"
                required
                maxlength="150"
                placeholder="e.g. Community Food Network"
            />
        </div>

        <div class="form-group">
            <label for="description">Description</label>
            <textarea
                id="description"
                name="description"
                required
                maxlength="500"
                rows="5"
                placeholder="Describe the organization's mission and community work"
            ></textarea>
        </div>

        <div class="form-group">
            <label for="contactEmail">Contact Email</label>
            <input
                type="email"
                id="contactEmail"
                name="contactEmail"
                required
                placeholder="contact@organization.org"
            />
        </div>

        <div class="form-actions">
            <a class="secondary-button" href="/organizations">Cancel</a>
            <button type="submit">Create Organization</button>
        </div>
    </form>
</main>
<%- include('partials/footer') %>
